{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      }
    },
    "preview-vendor": {
      "distribution": "internal",
      "channel": "preview-vendor",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      },
      "env": {
        "APP_VARIANT": "vendor",
        "VENDOR_EAS_PROJECT_ID": "81d21be4-16e8-4f76-b5b8-2bf2f40523ca"
      }
    },
    "production": {
      "channel": "production",
      "android": {
        "buildType": "app-bundle"
      },
      "autoIncrement": true
    },
    "production-vendor": {
      "channel": "production-vendor",
      "android": {
        "buildType": "app-bundle"
      },
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "vendor",
        "VENDOR_EAS_PROJECT_ID": "81d21be4-16e8-4f76-b5b8-2bf2f40523ca"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
